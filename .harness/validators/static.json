{
  "name": "recurring-buy-static",
  "description": "Files and manifest values the template must keep. template.json is asserted only where it exists: the CLI deletes it from scaffolded projects.",
  "jsonAssertions": [
    { "file": "template.json", "path": "create-scaffold-hbar.capabilities.frontend", "equals": ["nextjs-app"] },
    { "file": "template.json", "path": "create-scaffold-hbar.capabilities.solidityFramework", "equals": ["hardhat"] },
    { "file": "template.json", "path": "create-scaffold-hbar.capabilities.packageManager", "equals": ["yarn", "npm"] },
    { "file": "template.json", "path": "create-scaffold-hbar.defaults.solidityFramework", "equals": "hardhat" },
    { "file": "package.json", "path": "devDependencies.hedera-harness", "equals": "2.0.0-rc.4" }
  ],
  "fileAssertions": {
    "required": [
      "README.md",
      "AGENTS.md",
      "LICENSE",
      "package.json",
      "packages/hardhat/package.json",
      "packages/nextjs/package.json"
    ],
    "forbidden": [
      ".env",
      ".env.local",
      "packages/hardhat/.env",
      "packages/nextjs/.env",
      "packages/nextjs/.env.local"
    ]
  },
  "textAssertions": [
    { "file": "README.md", "contains": ["npx create-scaffold-hbar@latest"] }
  ]
}
